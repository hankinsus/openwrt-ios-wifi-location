# Example GitHub Actions workflow for pytest and three-viewport Playwright checks.
# Kept in docs/ (not .github/workflows/) so it can be versioned without a token that has the workflow scope.
# To enable it, copy this file to .github/workflows/ci.yml with a token that includes the workflow scope.
name: CI

on:
  push:
  pull_request:

jobs:
  test:
    name: unit-and-ui
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Check out
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Install Python test dependencies
        run: python -m pip install -U pip && python -m pip install -e ".[dev]"

      - name: Install Playwright Chromium
        run: python -m playwright install --with-deps chromium

      - name: Run full test suite
        run: python -m pytest
